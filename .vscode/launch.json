{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Inference on Samples",
      "type": "debugpy",
      "request": "launch",
      "program": "src/inference.py",
      "console": "integratedTerminal",
      "args": [
        "--mode",
        "detect",
        "--detection_config_path",
        "src/detection_config.json",
        "--detection_model_path",
        "models/pubtables1m_detection_detr_r18.pth",
        "--detection_device",
        "cuda",
        "--image_dir",
        "data/samples/images",
        "--words_dir",
        "data/samples/words",
        "--out_dir",
        "data/samples/outputs",
        "--crop_padding",
        "20",
        "-vzp"
      ]
    },
    {
      "name": "Evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "src/main.py",
      "console": "integratedTerminal",
      "args": [
        "--mode",
        "eval",
        "--data_type",
        "detection",
        "--config_file",
        "src/detection_config.json",
        "--data_root_dir",
        "~/data/pubtables-1m/PubTables-1M-Detection",
        "--model_load_path",
        "models/pubtables1m_detection_detr_r18.pth",
        "--distributed"
        // "--test_max_size",
        // "20"
      ]
    },
    {
      "name": "Training",
      "type": "debugpy",
      "request": "launch",
      "program": "src/main.py",
      "console": "integratedTerminal",
      "args": [
        "--mode",
        "train",
        "--data_type",
        "detection",
        "--config_file",
        "src/detection_config.json",
        "--data_root_dir",
        "~/data/pubtables-1m/PubTables-1M-Detection",
        "--model_save_dir",
        "models/original",
        // "--distributed",
        "--train_max_size",
        "5_000",
        "--val_max_size",
        "5_000"
      ]
    }
  ]
}
