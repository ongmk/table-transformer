{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Inference on Samples",
      "type": "debugpy",
      "request": "launch",
      "program": "src/inference.py",
      "console": "integratedTerminal",
      "args": [
        "--mode",
        "detect",
        "--detection_config_path",
        "~/table-transformer/src/detection_config.json",
        "--detection_model_path",
        "~/table-transformer/models/pubtables1m_detection_detr_r18.pth",
        "--detection_device",
        "cuda",
        "--image_dir",
        "~/table-transformer/data/samples/images",
        "--words_dir",
        "~/table-transformer/data/samples/words",
        "--out_dir",
        "~/table-transformer/data/samples/outputs",
        "--crop_padding",
        "20",
        "-vzp"
      ]
    }
  ]
}
